// Deploy as a Cloudflare Worker with static assets (no Worker code = no backend).
// Alternatively use Cloudflare Pages: build command `npm run build`, output dir `dist`.
{
  "name": "skybarge",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}
