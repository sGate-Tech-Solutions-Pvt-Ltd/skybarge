---
import { company, services } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="hatch" aria-hidden="true"></div>
  <div class="wrap footer__grid">
    <div>
      <img class="footer__logo" src="/images/logo-light.png" alt={company.name} width="210" height="56" loading="lazy" />
      <p>International freight forwarding, customs clearance and logistics from India since {company.founded}.</p>
    </div>
    <div>
      <h2>Our services</h2>
      <ul>
        {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Contact us</h2>
      <address>
        {company.address.map((l) => <>{l}<br /></>)}
      </address>
      <p>
        <a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a><br />
        <a href={`mailto:${company.email}`}>{company.email}</a><br />
        {company.hours}
      </p>
    </div>
    <div>
      <h2>Follow us</h2>
      <ul>
        {company.social.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap footer__legal">
    <p>Copyright © {year} {company.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: #c6d2dc; font-size: var(--step--1); }
  .hatch { height: 10px; background: var(--hatch); }
  .footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1.4fr 1fr 1.1fr 0.7fr;
    padding-block: 3.5rem 2.5rem;
  }
  .footer__logo { height: 48px; width: auto; margin-bottom: 1rem; }
  .footer h2 { font-size: 1.3rem; color: var(--white); margin-bottom: 0.9rem; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .footer a { color: var(--white); text-decoration: none; }
  .footer a:hover { text-decoration: underline; color: var(--white); }
  .footer address { font-style: normal; margin-bottom: 1em; }
  .footer__legal { border-top: 1px solid rgba(255,255,255,0.15); padding-block: 1.25rem; }
  .footer__legal p { margin: 0; }
  @media (max-width: 860px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
