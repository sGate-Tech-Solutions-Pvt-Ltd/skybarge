---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { capabilities, partners, company } from '../data/site';

const strengths = [
  { title: 'Packaging and storage', text: 'Palletisation, fumigation and secure storage before dispatch.' },
  { title: 'Warehousing service', text: 'Warehousing, indent deliveries and onward distribution.' },
  { title: 'Ground transport', text: 'Inland trucking, heavy-lift and over-dimensional cargo.' },
  { title: 'Logistic services', text: 'One contact for freight, customs, documentation and delivery.' },
];
---
<Base>
  <Hero />

  <section class="section welcome">
    <div class="wrap welcome__grid">
      <div>
        <h2>Welcome to Sky-Barge Freight</h2>
        <p class="lede">
          Sky-Barge started in January {company.founded} with a team of four, handling air export shipments out of Delhi.
        </p>
        <p>
          With passion, zeal and diligence, Sky-Barge kept creating and strengthening new verticals in international
          logistics, and spread its wings into every vertical of air and sea exports and imports. Headquartered in Delhi,
          Sky-Barge has its own offices at major locations and associate logistics partners across India.
        </p>
        <p>
          We offer a single-source solution for all your transportation, logistics, customs and trade needs, with a
          personalised experience for each customer.
        </p>
        <a class="btn btn--ghost" href="/about-us/">More about us</a>
      </div>
      <figure class="welcome__photo">
        <img src="/images/about.jpg" alt="Sky-Barge cargo operations" width="700" height="520" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <div class="head">
        <h2>What we do</h2>
        <p class="lede">Our services are driven by quality, focus on service, market awareness and fair pricing.</p>
      </div>
      <ul class="caps">
        {capabilities.map((c) => (
          <li>
            <img src={c.icon} alt="" width="56" height="56" loading="lazy" />
            <div>
              <h3>{c.title}</h3>
              <p>{c.detail}</p>
            </div>
          </li>
        ))}
      </ul>
      <p><a class="btn" href="/all-services/">See service details</a></p>
    </div>
  </section>

  <section class="section section--ink promise">
    <div class="wrap"><div class="promise__inner">
      <h2>Your cargo, delivered safe and on time</h2>
      <p class="lede">
        From pick-up to final delivery, one team looks after your shipment and keeps you informed at every stage.
      </p>
      <a class="btn btn--signal" href="/contact-us/">Contact us</a>
    </div></div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Our carrier partners</h2>
      </div>
      <div class="partners-slider" data-partners data-count={partners.length}>
      <button class="partners__arrow partners__arrow--prev" type="button" aria-label="Previous partner" data-prev>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <div class="partners">
        <ul class="partners__track">
          {[...partners, ...partners, ...partners].map((src, i) => {
            const isClone = i < partners.length || i >= partners.length * 2;
            return (
              <li aria-hidden={isClone ? 'true' : undefined}>
                <img src={src} alt={isClone ? '' : 'Carrier partner logo'} width="160" height="80" />
              </li>
            );
          })}
        </ul>
      </div>
      <button class="partners__arrow partners__arrow--next" type="button" aria-label="Next partner" data-next>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap special">
      <div>
        <h2>What makes us special?</h2>
        <p class="lede">
          We look for solutions that meet your needs, keep customers satisfied, and respect supply-chain timing and regulations.
        </p>
      </div>
      <dl>
        {strengths.map((s) => (
          <div>
            <dt>{s.title}</dt>
            <dd>{s.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section quote-section" id="quote">
    <div class="wrap quote__grid">
      <div>
        <h2>Request a free quote</h2>
        <p class="lede">Tell us what you are shipping and where. A member of our team will reply within one working day.</p>
        <p>
          Prefer to talk? Call <a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a>
          or email <a href={`mailto:${company.email}`}>{company.email}</a>.
        </p>
      </div>
      <QuoteForm />
    </div>
  </section>
</Base>

<script>
  // Logo carousel showing 4 logos (3 on tablet, 2 on phone): steps one logo at a time
  // and loops by snapping back into the middle copy of the tripled list.
  document.querySelectorAll<HTMLElement>('[data-partners]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('.partners')!;
    const track = root.querySelector<HTMLElement>('.partners__track')!;
    const count = Number(root.dataset.count);
    if (!count) return;

    let active = count;

    const perView = () => (window.innerWidth < 600 ? 2 : window.innerWidth < 960 ? 3 : 4);

    const render = (animate: boolean) => {
      const w = viewport.clientWidth / perView();
      track.style.setProperty('--w', `${w}px`);
      track.classList.toggle('is-animating', animate);
      track.style.transform = `translateX(${-active * w}px)`;
    };

    const step = (dir: 1 | -1 = 1) => {
      if (active >= count * 2 || active < count) {
        active += active < count ? count : -count;
        render(false);
        void track.offsetWidth; // flush so the snap-back is not animated
      }
      active += dir;
      render(true);
    };

    render(false);
    window.addEventListener('resize', () => render(false));

    const autoplay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = 0;
    const start = () => { if (autoplay) { window.clearInterval(timer); timer = window.setInterval(step, 2500); } };
    const stop = () => window.clearInterval(timer);

    root.querySelector('[data-prev]')!.addEventListener('click', () => step(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => step(1));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    start();
  });
</script>

<style>
  .head { margin-bottom: 2.5rem; }
  .head .lede { margin: 0; }

  .welcome__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .welcome__photo { margin: 0; position: relative; }
  .welcome__photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--paper); border-radius: var(--radius); }
  .welcome__photo::before {
    content: '';
    position: absolute;
    left: -14px; bottom: -14px;
    width: 45%; height: 45%;
    background: var(--hatch);
    z-index: -1;
  }
  .welcome { position: relative; isolation: isolate; }

  .caps {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px solid var(--ink);
  }
  .caps li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.5rem 1.25rem 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .caps img { width: 48px; height: 48px; flex: none; object-fit: contain; }
  .caps h3 { font-size: 1.35rem; margin: 0 0 0.2rem; }
  .caps p { margin: 0; color: var(--steel); font-size: var(--step--1); }

  .promise__inner { max-width: 48rem; }
  .promise h2 { font-size: var(--step-4); }

  .partners-slider { position: relative; display: flex; align-items: center; gap: 0.75rem; }
  .partners__arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .partners__arrow:hover,
  .partners__arrow:focus-visible { background: var(--ink); color: #fff; border-color: var(--ink); }
  .partners {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 1.5rem 0;
  }
  .partners__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
  }
  .partners__track.is-animating { transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1); }
  .partners li {
    flex: none;
    width: var(--w, 25%);
    display: grid;
    place-items: center;
    padding: 0 1.5rem;
    min-height: 7rem;
  }
  .partners img {
    max-height: 60px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.3s, opacity 0.3s;
  }
  .partners li:hover img { filter: none; opacity: 1; }

  @media (max-width: 600px) {
    .partners li { padding: 0 0.75rem; }
  }

  .special { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); }
  .special dl { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 2.5rem; }
  .special dl div { border-left: 4px solid var(--signal); padding-left: 1rem; }
  .special dt { font: 600 1.35rem/1.2 var(--font-display); margin-bottom: 0.3rem; }
  .special dd { margin: 0; color: var(--steel); }

  .quote__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .quote-section { border-top: 1px solid var(--line); }

  @media (max-width: 960px) {
    .caps { grid-template-columns: repeat(2, 1fr); }
    .welcome__grid, .special, .quote__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .caps { grid-template-columns: 1fr; }
    .special dl { grid-template-columns: 1fr; }
  }
</style>
