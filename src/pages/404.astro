---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section">
    <div class="wrap">
      <h1>This page is not on the manifest</h1>
      <p class="lede">The link may be from our old website. Try one of these instead.</p>
      <p style="display:flex;gap:.75rem;flex-wrap:wrap">
        <a class="btn" href="/">Go to the homepage</a>
        <a class="btn btn--ghost" href="/all-services/">See our services</a>
        <a class="btn btn--ghost" href="/contact-us/">Contact us</a>
      </p>
    </div>
  </section>
</Base>
